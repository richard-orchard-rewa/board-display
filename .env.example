# GitHub token (classic: repo + read:project; or fine-grained: Contents, Pull requests, Issues, Actions read + Projects read)
GITHUB_TOKEN=
GITHUB_REPO=Relationships-Australia-WA/feedback
# Optional: GitHub Project used by the Iteration slide
PROJECT_ORG=Relationships-Australia-WA
PROJECT_NUMBER=1
# mock | live  (live needs the machine-auth setup described in README)
FEEDBACK_MODE=mock
FEEDBACK_BASE_URL=https://feedback-dash.azurewebsites.net
PORT=3001
# Live feedback (FEEDBACK_MODE=live): app-only Entra client for feedback-dash's /api/display/summary
ENTRA_TENANT_ID=50a4b8be-02bc-4869-b084-979a5262bb22
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
FEEDBACK_API_SCOPE=api://1315affe-a2d2-4257-9200-6885039473d2/.default
